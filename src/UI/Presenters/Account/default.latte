{define title}
	{_fcadmin.presenters.account.pageTitle}
{/define}

{block content}

<div class="header">
	<h1 class="header-title">
		{_fcadmin.presenters.account.myProfile}
	</h1>

	<div class="header-actions">
		<a n:href="changePassword!" class="btn btn-outline-primary ajax">{_fcadmin.presenters.account.changePassword}</a>
		<a n:href="editPersonalData!" class="btn btn-primary ajax">{_fcadmin.presenters.account.editPersonalData}</a>
	</div>
</div>

<div class="card">
	<div class="card-body">
		<table class="table table-borderless mb-0">
			<tr>
				<th>{_fcadmin.forms.personalData.labels.firstName}</th>
				<td>{$identity->getFirstName()}</td>
			</tr>
			<tr>
				<th>{_fcadmin.forms.personalData.labels.lastName}</th>
				<td>{$identity->getLastName()}</td>
			</tr>
			<tr>
				<th>{_fcadmin.presenters.account.email}</th>
				<td>{$identity->getEmail()}</td>
			</tr>
			<tr>
				<th>{_fcadmin.forms.personalData.labels.phoneNumber}</th>
				<td>{$identity->getPhoneNumber()}</td>
			</tr>
		</table>
	</div>
</div>

{if $isPasskeyEnabled}
	<div class="header mt-4">
		<h2 class="header-title">
			{_fcadmin.passkeys.account.title}
		</h2>

		<div class="header-actions">
			<a n:href="addPasskey!" class="btn btn-primary ajax">{_fcadmin.passkeys.account.add}</a>
		</div>
	</div>

	{control passkeyGrid}
{/if}

{if $isKeycloak2faAvailable}
	<div class="header mt-4">
		<h2 class="header-title">
			{_fcadmin.twoFactor.account.title}
		</h2>

		<div class="header-actions">
			<a n:href="addTwoFactorKey!" class="btn btn-primary">
				{if $keycloak2faCredentials}
					{_fcadmin.twoFactor.account.addKey}
				{else}
					{_fcadmin.twoFactor.account.enable}
				{/if}
			</a>
		</div>
	</div>

	<div class="card">
		<div class="card-body">
			{if !$isKeycloak2faStateKnown}
				<p class="mb-0 text-muted">{_fcadmin.twoFactor.account.stateUnknownInfo}</p>
			{elseif !$keycloak2faCredentials}
				<p class="mb-0 text-muted">{_fcadmin.twoFactor.account.disabledInfo}</p>
			{else}
				<table class="table table-borderless mb-0">
					<thead>
						<tr>
							<th>{_fcadmin.twoFactor.grid.name}</th>
							<th>{_fcadmin.twoFactor.grid.createdAt}</th>
							<th></th>
						</tr>
					</thead>
					<tbody>
						<tr n:foreach="$keycloak2faCredentials as $credential">
							<td>
								{if $credential->getUserLabel()}
									{$credential->getUserLabel()}
								{else}
									{_fcadmin.twoFactor.grid.unnamedKey}
								{/if}
							</td>
							<td>{$credential->getCreatedAt()?->format('d.m.Y H:i')}</td>
							<td class="text-end">
								<a n:href="deleteTwoFactorKey! credentialId => $credential->getId()" class="text-danger">
									{_fcadmin.twoFactor.grid.delete}
								</a>
							</td>
						</tr>
					</tbody>
				</table>
			{/if}
		</div>
	</div>
{/if}

<div class="header mt-4">
	<h2 class="header-title">
		{_fcadmin.presenters.account.sessions}
	</h2>

	<div class="header-actions">
		<div class="dropdown">
			<button class="btn btn-light" type="button" data-bs-toggle="dropdown" aria-expanded="false">
				<i class="fa-solid fa-ellipsis-vertical"></i>
			</button>
			<ul class="dropdown-menu dropdown-menu-end">
				<li>
					<a n:href="logoutAll!" class="dropdown-item text-danger" onclick="if(!confirm('{_fcadmin.presenters.account.logoutAllConfirm}')){ event.preventDefault(); return false; }">
						{_fcadmin.presenters.account.logoutAll}
					</a>
				</li>
			</ul>
		</div>
	</div>
</div>

{control sessionGrid}
