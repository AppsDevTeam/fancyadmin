{varType ADT\FancyAdmin\Model\Security\SecurityUser $user}

<!DOCTYPE html>
<html lang="cs">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">

	<title n:snippet="title">{ifset title}{include title|stripHtml} | {/ifset}{$projectName}</title>

	{if !empty($keycloakSettingsJson ?? '')}
		<script>window.__keycloakSettings = {$keycloakSettingsJson|noescape};</script>
	{/if}
	{block head}{/block}

	<link rel="manifest" href="/manifest.webmanifest"/>
	<link n:ifset="$faviconFileNamePng" rel="icon" type="image/svg+xml" href="{$basePath}/favicon/{$faviconFileNamePng}">
	<link n:ifset="$faviconFileNameSvg" rel="icon" type="image/png" href="{$basePath}/favicon/{$faviconFileNameSvg}">
	{* Vite entry (portal mapping) — emits the module script + its extracted CSS (and dev-server HMR client). *}
	{asset 'portal:js/portal.js'}

	{block colors}
		{if isset($account) && $account?->getCss()}
			<style>
				{$account->getCss()|noescape}
			</style>
		{else}
			<style>
				:root {
					--backgroundColor: {$colors['backgroundColor']|noescape};
					--dashboardAccentColor: {$colors['dashboardAccentColor']|noescape};
					--primaryColor: {$colors['primaryColor']|noescape};
					--primaryColorDark: {$colors['primaryColorDark']|noescape};
					--primaryColorDark20: {$colors['primaryColorDark20']|noescape};
					--secondaryColor: {$colors['secondaryColor']|noescape};
					--secondaryColorDark: {$colors['secondaryColorDark']|noescape};
					--secondaryColorDarker: {$colors['secondaryColorDarker']|noescape};
					--tertiaryColor: {$colors['ternaryColor']|noescape};
					--tertiaryTextColor: {$colors['ternaryTextColor']|noescape};
					--loginBackground: {$colors['loginBackground']|noescape};
					--loginBackgroundInput: {$colors['loginBackgroundInput']|noescape};
					--loginInputTextColor: {$colors['loginInputTextColor']|noescape};
					--loginBackgroundInputFocus: {$colors['loginBackgroundInputFocus']|noescape};
					--inputBorder: {$colors['inputBorder']|noescape};
					--inputFocusBorder: {$colors['inputFocusBorder']|noescape};
					--inputFocusBackground: {$colors['inputFocusBackground']|noescape};
				}
			</style>
		{/if}
	{/block}
</head>

<body
	data-app-body
	data-adt-js-components="{$jsComponentsConfig}"
	data-adt-messaging
	data-adt-translate
	data-adt-safari-support
	data-summernote-upload="{$summernoteUpload ?? ''}"
>
<div n:snippet="body">
	<div data-adt-translate></div>

	{if $primaryTemplate}
		{block menu}
			{include @sideMenu.latte}
			{include @mobileMenu.latte}
		{/block}

		<div class="container-fluid delay-animate container-main" data-app-container>
			{if $presenter->getAction() === 'detail'}
				<nav style="height: 70px" class="d-flex">
					<div class="back-link">
						<a href="{ifset $showBackToOverviewLink}{$showBackToOverviewLink}{else}{plink default}{/ifset}">{_fcadmin.appGeneral.labels.backToOverview}</a>
					</div>
				</nav>
			{else}
				<nav n:if="$user->isAllowedFullDataAclResource() || $user->isAllowedBackoffice() || count($user->getIdentity()->getAccounts()) + count($user->getIdentity()->getSubaccounts()) > 1" style="height: 70px" class="d-flex">
					<div class="d-flex align-items-center" style="min-width: 100%; overflow: hidden">
						{control selectAccountForm}
					</div>
				</nav>
			{/if}

			<div id="content">
				{include content}
			</div>

{*			<div id="iOsA2HS" style="display: none;">*}
{*				<div class="iOsA2HS_backdrop closeA2H"></div>*}
{*				<div class="iOsA2HS_popup">*}
{*					<span style="position: absolute; right: 20px;top: 15px;">*}
{*						<i class="fa fa-times closeA2H"></i>*}
{*					</span>*}
{*					<div class="install-header">*}
{*						<div>*}
{*							<img src="/icon512_maskable.png" />*}
{*						</div>*}
{*						<div>Instalovat {$projectName}</div>*}
{*					</div>*}
{*					<hr />*}
{*					<ul style="list-style-type: decimal;margin: 10px 0;">*}
{*						<li>Klikněte na ikonu <i class="fa-regular fa-arrow-up-from-square"></i></li>*}
{*						<li>Vyberte možnost <b>Přidat na plochu</b></li>*}
{*					</ul>*}
{*				</div>*}
{*			</div>*}
		</div>

		<div class="side-panel-template-backdrop"></div>
		<div class="side-panel-template-container">
			{snippet sidePanel}{/snippet}
			<button type="button" class="btn-close"></button>
		</div>
	{else}
		<div class="bg-primary-variant container-login">
			<div class="wrap-login">
				{default $account = null}
				{if $account?->getLogo()}
					<img src="{$account->getLogo()->getUrl()}{v}" class="" width="226px" height="auto" alt="Logo {$account->getCompanyName()}" />
				{else}
					<img src="{$basePath}/images/logos/{$loginPageLogoPath}{v}" class="" width="226px" height="auto" alt="Logo {$projectName}" />
				{/if}

				{if !empty($showProfileMenu)}
					{include @profileMenu.latte}
				{/if}

				{if !empty($showBackButton)}
					{if	$presenter->getAction() !== 'default'}
						<p class="text-center"><a n:href="default">{_'fcadmin.layout.links.back'}</a></p>
					{else}
						<p class="text-center"><a n:href="Home: selectedAccount => $user->getIdentity()->getSelectedAccount()->getId()">{_'fcadmin.layout.links.backToHomepage'}</a></p>
					{/if}
				{/if}

				{include content}

				{if !$user->isLoggedIn() && !$presenter->isLinkCurrent(':Portal:Sign:in')}
					<p class="text-center"><a n:href=":Portal:Sign:in">{_'fcadmin.layout.links.goToLogin'}</a></p>
				{/if}
			</div>
			{if $account?->getLogo()}
				<img src="{$basePath}/images/logos/{$parameters['loginPageLogoFileName']}{v}" class="mt-4" width="146px" height="auto" alt="Logo {$parameters['title']}" />
			{/if}
		</div>
	{/if}

	<div n:snippet="flashes" class="snippet-flashes">
		<div n:foreach="$flashes as $flash" n:class="alert, 'alert-' . $flash->type" data-close-duration={$flash->closeDuration}>
			<div class="alert-text d-block">{$flash->message|noescape}</div>
			<div class="alert-close-btn-wrapper">
				<button class="alert-close-btn">
					{_fcadmin.global.flashes.close}
				</button>
			</div>
		</div>
	</div>
</div>
{snippet modals}
	{block modals}{/block}
{/snippet}
{block scripts}{/block}
</body>
</html>
