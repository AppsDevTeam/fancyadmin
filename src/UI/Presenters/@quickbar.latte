{varType ADT\FancyAdmin\Model\Quickbar\QuickbarItem[] $quickbarItems}
{varType string|null $quickbarAiUrl}
{* Rychlá lišta - kostra panelů; obsah seznamů vykresluje assets/js/quickbar.js z dat projektu *}
{var $hasSearch = in_array(ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Search, $quickbarItems, true)}
{var $buttons = array_filter($quickbarItems, fn($item) => $item !== ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Search)}

<div class="quickbar-overlay" data-quickbar-close hidden></div>
<div class="quickbar-column-resizer" data-quickbar-resizer role="separator" aria-orientation="vertical" aria-label="{_fcadmin.layout.quickbar.resize}" title="{_fcadmin.layout.quickbar.resizeHint}" tabindex="0" hidden></div>

{include @quickbarMenu.latte}

<section n:if="$hasSearch" class="quickbar-panel quickbar-panel--search" id="quickbar-panel-search" data-quickbar-panel="search" aria-label="{_fcadmin.layout.quickbar.search.title}" hidden>
	<header class="quickbar-panel-header">
		<h2 class="quickbar-panel-title">{_fcadmin.layout.quickbar.search.title}</h2>
		<div class="quickbar-panel-actions">
			{include pinButton}
			{include closeButton}
		</div>
	</header>
	{* Výsledky vybírají šipky z pole hledání (quickbar.js), kurzor v poli zůstává *}
	<div class="quickbar-panel-body" role="listbox" aria-label="{_fcadmin.layout.quickbar.search.title}" data-quickbar-results data-empty="{_fcadmin.layout.quickbar.search.empty}" data-no-results="{_fcadmin.layout.quickbar.search.noResults}"></div>
	<footer class="quickbar-panel-hint">
		<span><kbd class="quickbar-key">↑↓</kbd>{_fcadmin.layout.quickbar.search.select}</span>
		<span><kbd class="quickbar-key">↵</kbd>{_fcadmin.layout.quickbar.search.open}</span>
		<span><kbd class="quickbar-key">Esc</kbd>{_fcadmin.layout.quickbar.close}</span>
	</footer>
</section>

{foreach $buttons as $item}
	<section class="quickbar-panel quickbar-panel--{$item->value}" id="quickbar-panel-{$item->value}" data-quickbar-panel="{$item->value}" aria-label="{_'fcadmin.layout.quickbar.' . $item->value . '.title'}" hidden>
		<header class="quickbar-panel-header">
			<div class="quickbar-panel-heading">
				<h2 class="quickbar-panel-title" data-quickbar-title="{_'fcadmin.layout.quickbar.' . $item->value . '.title'}">{_'fcadmin.layout.quickbar.' . $item->value . '.title'}</h2>
				{* Ve vlákně chatu místo nadpisu šipka zpět a protějšek, vykresluje quickbar.js *}
				<div n:if="$item === ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Chat" class="quickbar-chat-current" data-quickbar-chat-current
					data-back="{_fcadmin.layout.quickbar.chat.back}" data-colleague="{_fcadmin.layout.quickbar.chat.colleague}" data-group="{_fcadmin.layout.quickbar.chat.group}"
					data-channel="{_fcadmin.layout.quickbar.chat.channel}" data-private-channel="{_fcadmin.layout.quickbar.chat.privateChannel}"
					data-thread="{_fcadmin.layout.quickbar.chat.thread}" data-thread-back="{_fcadmin.layout.quickbar.chat.threadBack}"
					data-follow="{_fcadmin.layout.quickbar.chat.follow}" data-unfollow="{_fcadmin.layout.quickbar.chat.unfollow}"></div>
			</div>
			<div class="quickbar-panel-actions">
				{if $item === ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Ai}
					{* Předčítání odpovědí aplikací ADTalk (quickbarSpeech.js) *}
					<button type="button" class="btn btn-icon btn-sm btn-glass" data-quickbar-ai-speak
						data-on="{_fcadmin.layout.quickbar.ai.speakOn}" data-off="{_fcadmin.layout.quickbar.ai.speakOff}" data-stop="{_fcadmin.layout.quickbar.ai.speakStop}"
						data-unavailable="{_fcadmin.layout.quickbar.ai.speakUnavailable}"><i class="fa-solid fa-volume-xmark"></i></button>
					{* Odkaz na otevřenou konverzaci (stránka AI ji otevře), jen když nějaká je *}
					<button type="button" class="btn btn-icon btn-sm btn-glass" title="{_fcadmin.layout.quickbar.ai.copyLink}" data-quickbar-ai-copy-link
						data-copied="{_fcadmin.layout.quickbar.ai.linkCopied}" hidden><i class="fa-solid fa-link"></i></button>
					<button type="button" class="btn btn-icon btn-sm btn-glass" title="{_fcadmin.layout.quickbar.ai.newConversation}" data-quickbar-ai-new><i class="fa-solid fa-plus"></i></button>
					<button type="button" class="btn btn-icon btn-sm btn-glass quickbar-ai-recent-button" title="{_fcadmin.layout.quickbar.ai.recent}" data-quickbar-ai-recent-toggle><i class="fa-solid fa-clock-rotate-left"></i></button>
					<button type="button" class="btn btn-icon btn-sm btn-glass quickbar-ai-full-button" title="{_fcadmin.layout.quickbar.ai.expand}" data-quickbar-ai-full
						data-expand="{_fcadmin.layout.quickbar.ai.expand}" data-shrink="{_fcadmin.layout.quickbar.ai.shrink}"><i class="fa-solid fa-up-right-and-down-left-from-center"></i></button>
				{/if}
				<button n:if="$item === ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Notifications" type="button" class="btn btn-icon btn-sm btn-glass" title="{_fcadmin.layout.quickbar.notifications.readAll}" data-quickbar-read-all><i class="fa-solid fa-check-double"></i></button>
				{* Hotové úkoly pod nehotovými - volbu si pamatuje prohlížeč (quickbar.js) *}
				<button n:if="$item === ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Todo" type="button" class="btn btn-icon btn-sm btn-glass" title="{_fcadmin.layout.quickbar.todo.showDone}" aria-pressed="false"
					data-show="{_fcadmin.layout.quickbar.todo.showDone}" data-hide="{_fcadmin.layout.quickbar.todo.hideDone}" data-quickbar-todo-done-toggle><i class="fa-solid fa-list-check"></i></button>
				{include pinButton}
				{include closeButton}
			</div>
		</header>

		{switch $item}
			{case ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Ai}
				{* Vlákno a odesílání je widget AI asistenta (assets/js/aiChat.js), konfiguraci si lišta načte z AiPresenteru *}
				<div class="quickbar-ai" data-quickbar-ai="{$quickbarAiUrl}">
					{* Seznam konverzací vlevo, jen když je okno roztažené na celou plochu *}
					<aside class="quickbar-ai-sidebar">
						<div class="quickbar-ai-sidebar-search">
							<div class="quickbar-search-field">
								<i class="fa-solid fa-magnifying-glass"></i>
								<input type="text" class="form-control form-control-sm" placeholder="{_fcadmin.layout.quickbar.ai.search}" aria-label="{_fcadmin.layout.quickbar.ai.search}" data-quickbar-ai-query>
								<button type="button" class="quickbar-search-clear" title="{_fcadmin.layout.quickbar.clear}" data-quickbar-clear><i class="fa-solid fa-xmark"></i></button>
							</div>
						</div>
						<div class="quickbar-ai-sidebar-list" data-quickbar-ai-groups data-empty="{_fcadmin.layout.quickbar.ai.noConversations}" data-no-results="{_fcadmin.layout.quickbar.ai.noResults}"
							data-today="{_fcadmin.layout.quickbar.ai.today}" data-yesterday="{_fcadmin.layout.quickbar.ai.yesterday}" data-week="{_fcadmin.layout.quickbar.ai.week}" data-older="{_fcadmin.layout.quickbar.ai.older}"></div>
						<div class="quickbar-ai-sidebar-footer">
							<a class="quickbar-ai-all" data-quickbar-ai-all hidden>{_fcadmin.layout.quickbar.ai.allConversations}<i class="fa-solid fa-arrow-right"></i></a>
						</div>
					</aside>
					<div class="quickbar-ai-recent" data-quickbar-ai-recent>
						<div class="quickbar-ai-recent-heading">
							<button type="button" class="quickbar-ai-back" title="{_fcadmin.layout.quickbar.ai.back}" data-quickbar-ai-recent-toggle><i class="fa-solid fa-arrow-left"></i></button>
							<span>{_fcadmin.layout.quickbar.ai.recent}</span>
						</div>
						<div class="quickbar-ai-list" data-quickbar-ai-list data-empty="{_fcadmin.layout.quickbar.ai.noConversations}" data-untitled="{_fcadmin.layout.quickbar.ai.untitled}" data-unread="{_fcadmin.layout.quickbar.ai.unread}"></div>
						<a class="quickbar-ai-all" data-quickbar-ai-all hidden>{_fcadmin.layout.quickbar.ai.allConversations}<i class="fa-solid fa-arrow-right"></i></a>
					</div>
					<div class="quickbar-ai-empty">
						<span class="quickbar-ai-empty-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
						<span class="quickbar-ai-empty-title">{_fcadmin.layout.quickbar.ai.emptyTitle}</span>
						<span class="quickbar-ai-empty-text">{_fcadmin.layout.quickbar.ai.emptyText}</span>
					</div>
					<div class="quickbar-ai-chat" data-quickbar-ai-chat data-loading="{_fcadmin.layout.quickbar.ai.loadingChat}" data-unavailable="{_fcadmin.layout.quickbar.ai.unavailable}"></div>
				</div>
			{case ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Notifications}
				<div class="quickbar-panel-body" data-quickbar-list="notifications" data-empty="{_fcadmin.layout.quickbar.notifications.empty}"></div>
			{case ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Todo}
				<div class="quickbar-panel-body" data-quickbar-list="todo" data-empty="{_fcadmin.layout.quickbar.todo.empty}"></div>
				<form class="quickbar-panel-form noajax" data-quickbar-form="todo">
					<input type="text" class="form-control form-control-sm" placeholder="{_fcadmin.layout.quickbar.todo.placeholder}" aria-label="{_fcadmin.layout.quickbar.todo.placeholder}">
					<button type="submit" class="btn btn-sm btn-primary">{_fcadmin.global.buttons.add}</button>
				</form>
			{case ADT\FancyAdmin\Model\Quickbar\QuickbarItem::Chat}
				<div class="quickbar-chat-list">
					<div class="quickbar-chat-search">
						<div class="quickbar-search-field">
							<i class="fa-solid fa-magnifying-glass"></i>
							<input type="text" class="form-control form-control-sm" placeholder="{_fcadmin.layout.quickbar.chat.search}" aria-label="{_fcadmin.layout.quickbar.chat.search}" data-quickbar-chat-query>
							<button type="button" class="quickbar-search-clear" title="{_fcadmin.layout.quickbar.clear}" data-quickbar-clear><i class="fa-solid fa-xmark"></i></button>
						</div>
					</div>
					{* Nový kanál a procházení kanálů ukáže quickbar.js, jen když je zdroj umí *}
					<div class="quickbar-chat-tools" data-quickbar-chat-tools data-new="{_fcadmin.layout.quickbar.chat.newChannel}" data-browse="{_fcadmin.layout.quickbar.chat.browseChannels}" hidden></div>
					<div class="quickbar-panel-body quickbar-chats" data-quickbar-chats data-empty="{_fcadmin.layout.quickbar.chat.empty}" data-no-results="{_fcadmin.layout.quickbar.search.noResults}"
						data-threads="{_fcadmin.layout.quickbar.chat.threads}" data-threads-hint="{_fcadmin.layout.quickbar.chat.threadsHint}"
						data-reminders="{_fcadmin.layout.quickbar.chat.reminders}" data-reminders-hint="{_fcadmin.layout.quickbar.chat.remindersHint}"></div>
					<div class="quickbar-channels" data-quickbar-channels
						data-new="{_fcadmin.layout.quickbar.chat.newChannel}" data-browse="{_fcadmin.layout.quickbar.chat.browseChannels}" data-back="{_fcadmin.layout.quickbar.chat.back}"
						data-name="{_fcadmin.layout.quickbar.chat.channelName}" data-private="{_fcadmin.layout.quickbar.chat.channelPrivate}" data-private-hint="{_fcadmin.layout.quickbar.chat.channelPrivateHint}"
						data-members="{_fcadmin.layout.quickbar.chat.channelMembers}" data-members-search="{_fcadmin.layout.quickbar.chat.channelMembersSearch}" data-create="{_fcadmin.layout.quickbar.chat.channelCreate}"
						data-colleagues-empty="{_fcadmin.layout.quickbar.picker.empty}" data-empty="{_fcadmin.layout.quickbar.chat.channelsEmpty}"
						data-members-count="{_fcadmin.layout.quickbar.chat.channelMembersCount}" data-join="{_fcadmin.layout.quickbar.chat.channelJoin}" data-open="{_fcadmin.layout.quickbar.chat.channelOpen}"
						data-threads="{_fcadmin.layout.quickbar.chat.threads}" data-threads-empty="{_fcadmin.layout.quickbar.chat.threadsEmpty}"
						data-reminders="{_fcadmin.layout.quickbar.chat.reminders}" data-reminders-empty="{_fcadmin.layout.quickbar.chat.remindersEmpty}" data-reminder-done="{_fcadmin.layout.quickbar.chat.reminderDone}" hidden></div>
				</div>
				<div class="quickbar-chat-pinned" data-quickbar-chat-pinned data-label="{_fcadmin.layout.quickbar.chat.pinned}" hidden></div>
				<div class="quickbar-chat-news" data-quickbar-chat-news data-one="{_fcadmin.layout.quickbar.chat.threadNewsOne}" data-few="{_fcadmin.layout.quickbar.chat.threadNewsFew}"
					data-many="{_fcadmin.layout.quickbar.chat.threadNewsMany}" data-open="{_fcadmin.layout.quickbar.chat.threadNewsOpen}" hidden></div>
				<div class="quickbar-thread" data-quickbar-thread
					data-reply="{_fcadmin.layout.quickbar.chat.reply}" data-replies-one="{_fcadmin.layout.quickbar.chat.repliesOne}" data-replies-few="{_fcadmin.layout.quickbar.chat.repliesFew}"
					data-replies-many="{_fcadmin.layout.quickbar.chat.repliesMany}" data-last-reply="{_fcadmin.layout.quickbar.chat.lastReply}"
					data-pin="{_fcadmin.layout.quickbar.chat.pin}" data-unpin="{_fcadmin.layout.quickbar.chat.unpin}" data-actions="{_fcadmin.layout.quickbar.chat.actions}"
					data-remind="{_fcadmin.layout.quickbar.chat.remind}" data-remind-minutes="{_fcadmin.layout.quickbar.chat.remindMinutes}" data-remind-hour="{_fcadmin.layout.quickbar.chat.remindHour}"
					data-remind-tomorrow="{_fcadmin.layout.quickbar.chat.remindTomorrow}" data-remind-custom="{_fcadmin.layout.quickbar.chat.remindCustom}" data-remind-set="{_fcadmin.layout.quickbar.chat.remindSet}"
					data-new-replies-one="{_fcadmin.layout.quickbar.chat.newRepliesOne}" data-new-replies-few="{_fcadmin.layout.quickbar.chat.newRepliesFew}" data-new-replies-many="{_fcadmin.layout.quickbar.chat.newRepliesMany}"></div>
				{* Téma konverzace, výběr zpráv, nabídka plusu a výběr položky vykresluje quickbar.js *}
				<div class="quickbar-chat-topic" data-quickbar-chat-topic data-label="{_fcadmin.layout.quickbar.chat.topic}" data-clear="{_fcadmin.layout.quickbar.chat.topicClear}" hidden></div>
				<div class="quickbar-chat-selection" data-quickbar-chat-selection
					data-count="{_fcadmin.layout.quickbar.chat.selected}" data-cancel="{_fcadmin.layout.quickbar.chat.selectCancel}" data-hint="{_fcadmin.layout.quickbar.chat.selectHint}" hidden></div>
				<div class="quickbar-chat-menu" data-quickbar-chat-menu data-select="{_fcadmin.layout.quickbar.chat.select}" role="menu" hidden></div>
				<div class="quickbar-picker" data-quickbar-picker
					data-close="{_fcadmin.layout.quickbar.picker.close}" data-empty="{_fcadmin.layout.quickbar.picker.empty}"
					data-short="{_fcadmin.layout.quickbar.picker.short}" data-suggestions="{_fcadmin.layout.quickbar.picker.suggestions}" hidden></div>
				<div class="quickbar-chat-files" data-quickbar-chat-files data-remove="{_fcadmin.layout.quickbar.chat.removeFile}" hidden></div>
				<form class="quickbar-panel-form quickbar-chat-form noajax" data-quickbar-form="chat">
					<button type="button" class="btn btn-icon btn-sm btn-ghost quickbar-chat-plus" title="{_fcadmin.layout.quickbar.chat.more}" aria-label="{_fcadmin.layout.quickbar.chat.more}"
						aria-haspopup="menu" aria-expanded="false" data-quickbar-chat-plus hidden><i class="fa-regular fa-plus"></i></button>
					<button type="button" class="btn btn-icon btn-sm btn-ghost" title="{_fcadmin.layout.quickbar.chat.attach}" aria-label="{_fcadmin.layout.quickbar.chat.attach}" data-quickbar-chat-attach hidden><i class="fa-solid fa-paperclip"></i></button>
					<input type="text" class="form-control form-control-sm" placeholder="{_fcadmin.layout.quickbar.chat.placeholder}" aria-label="{_fcadmin.layout.quickbar.chat.placeholder}">
					<input type="file" multiple hidden data-quickbar-chat-file>
					<button type="submit" class="btn btn-icon btn-sm btn-primary" title="{_fcadmin.layout.quickbar.chat.send}"><i class="fa-regular fa-paper-plane"></i></button>
				</form>
		{/switch}
	</section>
{/foreach}

{* Bez položek jen Menu na mobilu (QuickbarSettings::isMobileMenu()), na širší obrazovce se lišta nekreslí *}
<div n:class="quickbar, $hasSearch ? quickbar--with-search, !$quickbarItems ? quickbar--menu-only" data-quickbar>
	{* Menu a ikonové hledání jen na mobilu, viz _quickbar.scss *}
	<button type="button" class="btn btn-icon btn-sm btn-glass quickbar-button quickbar-menu-button" title="{_fcadmin.layout.quickbar.menu.label}" aria-label="{_fcadmin.layout.quickbar.menu.label}"
		aria-controls="quickbar-panel-menu" aria-expanded="false" data-quickbar-toggle="menu"><i class="fa-solid fa-bars"></i></button>
	<button n:if="$hasSearch" type="button" class="btn btn-icon btn-sm btn-glass quickbar-button quickbar-search-button" title="{_fcadmin.layout.quickbar.search.placeholder}" aria-label="{_fcadmin.layout.quickbar.search.placeholder}"
		aria-controls="quickbar-panel-search" data-quickbar-toggle="search"><i class="fa-solid fa-magnifying-glass"></i></button>
	<label n:if="$hasSearch" class="quickbar-search">
		<i class="fa-solid fa-magnifying-glass"></i>
		<input type="text" class="quickbar-search-input" autocomplete="off"
			placeholder="{_fcadmin.layout.quickbar.search.placeholder}"
			data-placeholder-closed="{_fcadmin.layout.quickbar.search.placeholder}"
			data-placeholder-open="{_fcadmin.layout.quickbar.search.placeholderOpen}"
			role="combobox" aria-autocomplete="list" aria-label="{_fcadmin.layout.quickbar.search.title}" aria-controls="quickbar-panel-search" aria-expanded="false"
			data-quickbar-search>
		<kbd class="quickbar-key" data-quickbar-shortcut>Ctrl K</kbd>
	</label>
	<div n:if="$hasSearch && $buttons" class="quickbar-divider"></div>
	<div n:if="$buttons" class="quickbar-buttons">
		<button n:foreach="$buttons as $item" type="button" class="btn btn-icon btn-sm btn-glass quickbar-button quickbar-button--{$item->value}"
			title="{_'fcadmin.layout.quickbar.' . $item->value . '.label'}" aria-controls="quickbar-panel-{$item->value}" aria-expanded="false"
			data-quickbar-toggle="{$item->value}">
			<i class="fa-solid fa-{$item->getIcon()}"></i>
			<span n:if="$item->getBadgeClass()" class="badge {$item->getBadgeClass()} quickbar-badge" data-quickbar-count="{$item->value}" hidden></span>
		</button>
	</div>
</div>

{* Připnutí sloupce (od md) - stav a popisek přepíná quickbar.js *}
{define pinButton}
	<button type="button" class="btn btn-icon btn-sm btn-glass quickbar-column-pin" title="{_fcadmin.layout.quickbar.pin}" aria-pressed="false"
		data-pin="{_fcadmin.layout.quickbar.pin}" data-unpin="{_fcadmin.layout.quickbar.unpin}" data-quickbar-column-pin><i class="fa-solid fa-thumbtack"></i></button>
{/define}

{define closeButton}
	<button type="button" class="btn btn-icon btn-sm btn-glass" title="{_fcadmin.layout.quickbar.close}" data-quickbar-close><i class="fa-solid fa-xmark"></i></button>
{/define}
