{define title}{_fcadmin.tablets.device.title}{/define}

{*
  Čekací stránka tabletu (TabletDevicePresenterTrait). Stav (povolení notifikací, čekání)
  přepíná @fancyadmin/js/tablet podle data-tablet-state. Odeslaný formulář si stránka vyzvedne
  a otevře při načtení a po push zprávě (řekne jí to service worker, sw.js.latte) - bez
  notifikací ji proto stačí obnovit (tlačítko Obnovit, aplikace z plochy jiné nemá).
*}
{block content}

{if $tablet}
	<div class="tablet-device" data-tablet-device
		data-vapid-key="{$vapidPublicKey}"
		data-sw-url="{link sw}"
		data-sw-scope="{$swScope}"
		data-register-url="{link registerPush!}"
		data-take-form-url="{link takeForm!}"
		data-tablet-state="loading">
		<span class="tablet-device-icon is-success"><i class="fa-solid fa-tablet-screen-button"></i></span>
		<h1>{$tablet->getName()}</h1>

		<div class="tablet-state tablet-state-loading">
			<p class="mt-3 mb-0"><i class="fa-solid fa-spinner fa-spin me-2"></i>{_fcadmin.tablets.device.loading}</p>
		</div>
		<div class="tablet-state tablet-state-ready">
			<p class="mt-3">{_fcadmin.tablets.device.ready}</p>
			<p class="mb-0">{_fcadmin.tablets.device.readyHint}</p>
		</div>
		<div class="tablet-state tablet-state-permission">
			<p class="mt-3">{_fcadmin.tablets.device.permission}</p>
			<button type="button" class="btn btn-primary" data-tablet-enable>{_fcadmin.tablets.device.enable}</button>
		</div>
		<div class="tablet-state tablet-state-denied">
			<p class="mt-3 mb-0">{_fcadmin.tablets.device.denied}</p>
		</div>
		<div class="tablet-state tablet-state-unsupported">
			<p class="mt-3">{_fcadmin.tablets.device.unsupported}</p>
			<p class="mb-0">{_fcadmin.tablets.device.unsupportedHint}</p>
		</div>
		<div class="tablet-state tablet-state-error">
			<p class="mt-3 mb-0">{_fcadmin.tablets.device.error}</p>
		</div>
		{* Bez notifikací se formulář ukáže až po obnovení stránky *}
		<p class="tablet-reload-hint mt-3 mb-0">{_fcadmin.tablets.device.reloadHint}</p>
		<button type="button" class="btn btn-outline-secondary mt-3" data-tablet-reload><i class="fa-solid fa-rotate me-2"></i>{_fcadmin.tablets.device.reload}</button>
	</div>
{else}
	<div class="tablet-device">
		<span class="tablet-device-icon is-warning"><i class="fa-solid fa-tablet-screen-button"></i></span>
		<h1>{_fcadmin.tablets.device.notPaired}</h1>
		<p class="mt-3 mb-0">{_fcadmin.tablets.device.notPairedHint}</p>
	</div>
{/if}

{/block}
