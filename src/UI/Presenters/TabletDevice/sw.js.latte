{contentType javascript}
// Service worker tabletu (TabletDevicePresenterTrait::actionSw, docs/tablets.md). Push zpráva je prázdná - jen
// probudí tablet, odeslaný formulář čeká u serveru (takeForm!, cookie tabletu).
//
// Formulář vyzvedává a otevírá jen čekací stránka (tablet.js): worker ukáže notifikaci a stránce
// řekne, ať se zeptá hned. Sám si ho nevyzvedává - otevřít ho totiž spolehlivě neumí: iOS po
// klepnutí na notifikaci otevře aplikaci na čekací stránce, ne na odkazu z workeru, a vyzvednutý
// formulář by pak už stránka nedostala. Na formulář se jen dívá (peek), aby ho v notifikaci
// pojmenoval. Notifikaci ukazuje ke každé push zprávě (prohlížeče to chtějí, Safari jinak odběr
// zruší); stránka ji po vyzvednutí formuláře zavře.

const TAKE_FORM_URL = {link takeForm!};
const WAITING_URL = {link default};

// Stejné hodnoty má tablet.js: zpráva čekací stránce "zeptej se hned" a značka notifikace, kterou stránka zavírá
const PICK_UP_MESSAGE = 'fancyadmin-tablet-form';
const NOTIFICATION_TAG = 'fancyadmin-tablet-form';

function windowClients() {
	return self.clients.matchAll({ type: 'window', includeUncontrolled: true });
}

// Čekající formulář bez vyzvednutí (peek) - dál čeká na čekací stránku
async function peekForm() {
	try {
		const body = new FormData();
		body.append('peek', '1');
		const response = await fetch(TAKE_FORM_URL, { method: 'POST', body, credentials: 'same-origin' });
		return response.ok ? (await response.json()).form : null;
	} catch {
		// Bez sítě - notifikace stránku aspoň otevře
		return null;
	}
}

function askToPickUp(clients) {
	clients.forEach((client) => client.postMessage({ type: PICK_UP_MESSAGE }));
}

async function handlePush() {
	const form = await peekForm();
	const clients = await windowClients();

	// Bez notifikace jen když nic nečeká a tablet svítí - formulář už čekací stránka otevřela
	// (vyzvedla si ho při načtení). Nejdřív notifikace, pak zpráva - stránka ji po vyzvednutí zavře.
	if (form || !clients.some((client) => client.visibilityState === 'visible')) {
		try {
			await self.registration.showNotification(form ? (form.title || {_fcadmin.tablets.device.notificationForm}) : {_fcadmin.tablets.device.title}, {
				body: form ? {_fcadmin.tablets.device.notificationOpenForm} : {_fcadmin.tablets.device.notificationOpenWaiting},
				tag: NOTIFICATION_TAG,
				requireInteraction: true,
			});
		} catch {
			// Notifikace mezitím zakázané - otevřená stránka formulář vyzvedne i tak
		}
	}

	// Stránce se říká vždy - i když se worker na formulář nedoptal (výpadek sítě, chyba serveru)
	askToPickUp(clients);
}

// Klepnutí na notifikaci: tablet na čekací stránku, ta si formulář vyzvedne a otevře. Otevřená
// stránka se nikam nepřesměrovává - může to být formulář, který zákazník právě vyplňuje.
async function openWaitingPage() {
	const clients = await windowClients();
	if (clients.length === 0) {
		await self.clients.openWindow(WAITING_URL);
		return;
	}

	try {
		await (clients.find((client) => client.visibilityState === 'visible') || clients[0]).focus();
	} catch {
		// Do popředí ji dostane systém sám (klepnutí na notifikaci aplikaci otevře)
	}
	askToPickUp(clients);
}

self.addEventListener('push', (event) => {
	event.waitUntil(handlePush());
});

self.addEventListener('notificationclick', (event) => {
	event.notification.close();
	event.waitUntil(openWaitingPage());
});

// Nová verze workeru převezme tablet hned, ne až po zavření všech oken
self.addEventListener('install', () => self.skipWaiting());
self.addEventListener('activate', (event) => event.waitUntil(self.clients.claim()));
