{varType ADT\FancyAdmin\Model\Security\SecurityUser $user}
{varType ADT\FancyAdmin\Model\Menu\UserMenu $userMenu}
{var $identity = $user->getIdentity()}
{var $roles = $identity->getRoles()}
{var $roleName = $roles ? reset($roles)->getName() : null}
<div class="bottom-menu">
    <div class="dropdown user">
        <button class="btn user-button" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="btn-avatar">
                <i class="fa-solid fa-xl fa-user"></i>
                <img src="{$identity->getGravatar()}" alt="gravatar" />
            </span>
            <span class="user-button-info">
                <span class="user-button-name">{$identity->getFullName()}</span>
                <span n:if="$roleName" class="user-button-role">{$roleName}</span>
            </span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end user-dropdown dropdown-menu-bottom">
            <li class="dropdown-item user-item-wrapper">
                <div class="user-item">
                    <div class="col-auto">
                        <i class="fa-solid fa-circle-user"></i>
                        <img src="{$user->getIdentity()->getGravatar()}" alt="gravatar" />
                    </div>
                    <div class="col-auto">
                        <div>{$user->getIdentity()->getFirstName()}</div>
                        <div>{$user->getIdentity()->getEmail()}</div>
                    </div>
                </div>
            </li>
            <li><hr class="dropdown-divider"></li>
            <a n:if="$userMenu->isAddMyAccountMenuItem()" n:href="Account:default" class="dropdown-item">
                <div>
                    <div>
                        <i class="fa-solid fa-user-lock"></i>
                    </div>
                    <div>
                        {_fcadmin.modules.web.navbar.account.myAccount}
                    </div>
                </div>
            </a>
            <li n:if="$userMenu->isFirebaseMenuItem()" class="dropdown-item" data-adt-notifications="" data-adt-notifications-enable="" style="display:none">
                <div>
                    <div>
                        <i class="fa-solid fa-bell"></i>
                    </div>
                    <div>
                        Povolit notifikace
                    </div>
                </div>
            </li>
            <li n:if="$userMenu->isFirebaseMenuItem()" class="dropdown-item" data-adt-notifications="" data-adt-notifications-disable="" style="display:none">
                <div>
                    <div>
                        <i class="fa-solid fa-bell-slash"></i>
                    </div>
                    <div>
                        Vypnout notifikace
                    </div>
                </div>
            </li>
            {foreach $userMenu->getMenuItems() as $item}
                {var $link = $presenter->link($item->getLink(), $item->getLinkArgs())}
                <a href="{$link}" class="dropdown-item">
                    <div>
                        <div>
                            <i class="fa-solid fa-{$item->getFaIcon()}"></i>
                        </div>
                        <div>
                            {_$item->getLabel()}
                        </div>
                    </div>
                </a>
            {/foreach}
            <li><hr class="dropdown-divider"></li>
            <li class="logout-item">
                <a class="dropdown-item" n:href=":Portal:Sign:out">
                    <div>
                        <div>
                            <i class="fa-solid fa-right-to-bracket"></i>
                        </div>
                        <div>
                            {_fcadmin.layout.sideMenu.user.logout}
                        </div>
                    </div>
                </a>
            </li>
        </ul>
    </div>
</div>
