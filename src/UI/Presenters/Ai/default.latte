{define title}{_fcadmin.presenters.ai.title}{/define}

{block content}

<div class="header">
	<h1 class="header-title">{_fcadmin.presenters.ai.pageTitle}</h1>
	<div class="header-actions">
		<a n:if="$aiMcpTokensLink" class="btn btn-outline-secondary" href="{$aiMcpTokensLink}">{_fcadmin.presenters.ai.mcpTokens}</a>
		<a class="btn btn-primary ajax" n:href="new!">{_fcadmin.presenters.ai.newConversation}</a>
	</div>
</div>

{* assets/js/aiChat.js po založení konverzace v panelu obnoví grid přes tento odkaz,
   konverzaci ze sdíleného odkazu (?conversation=ID) otevře přes aiOpen! *}
<div data-adt-fancyadmin-ai-grid-refresh="{link refreshAiConversations!}" n:attr="data-adt-fancyadmin-ai-open => $aiOpenLink">
	{control aiConversationGrid}
</div>
