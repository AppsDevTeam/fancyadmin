{define section-lostPassword}
	<a href="{plink "Sign:lostPassword"}" class="linkInForm">
		<span class="d-sm-inline">{_fcadmin.forms.signIn.links.lostPassword}</span>
	</a>
{/define}

{define section-passkey}
	{if $isPasskeyEnabled}
	<div
		class="passkey-login mt-3 mt-sm-0"
		data-adt-fancyadmin-passkey-login
		data-passkey-args-url="{link passkeyLoginArgs!}"
		data-passkey-verify-url="{link passkeyLoginVerify!}"
		data-passkey-error-unsupported="{_fcadmin.passkeys.errors.unsupportedBrowser}"
		data-passkey-error-failed="{_fcadmin.passkeys.errors.loginFailed}"
	>
		<button type="button" class="btn btn-primary w-100" data-passkey-login-button>
			<i class="fa-solid fa-fingerprint" style="margin-right: 20px"></i>
			{_fcadmin.passkeys.loginButton}
		</button>
		<div class="alert alert-danger mt-2 d-none" data-passkey-error></div>
	</div>
	{/if}
{/define}

{define section-signInButtons}
	<div class="sign-in-buttons">
		<a n:foreach="$signInButtons as $button" href="{plink $button->destination, (expand) $button->args}" class="btn btn-primary w-100">
			<i n:if="$button->icon" class="{$button->icon} me-3"></i>
			{_$button->label}
		</a>
	</div>
{/define}
