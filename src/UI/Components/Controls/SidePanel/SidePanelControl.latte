{ifset $fileName}
	{import $fileName}
{/ifset}

{ifset body}
	{include body}
{else}
	{control form}
{/ifset}

{* Až za formulářem - nadpis bere z jeho záznamu *}
<div class="side-panel-config" data-size="{$size}" data-close-confirm="{_$closeConfirm}" n:attr="data-stacked => $stacked, data-title => $control->getTitle()"></div>
