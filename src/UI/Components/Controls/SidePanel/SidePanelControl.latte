{ifset $fileName}
	{import $fileName}
{/ifset}

{ifset body}
	{include body}
{else}
	{control form}
{/ifset}

<div class="side-panel-config" data-size="{$size}" data-close-confirm="{_$closeConfirm}" data-close-confirm-text="{_fcadmin.sidePanels.control.closeConfirmText}" data-close-confirm-discard="{_fcadmin.sidePanels.control.closeConfirmDiscard}" data-close-confirm-continue="{_fcadmin.sidePanels.control.closeConfirmContinue}" n:attr="data-stacked => $stacked"></div>
