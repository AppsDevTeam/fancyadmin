{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\Widget $widget}
{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\WidgetGridControl $widgetGrid}
{varType string $format}

{* Dlaždice jsou samy kartami, ostatní widgety jsou v kartě. Sbalitelný widget je <details> - hlavička je
   <summary>, otevřít i zavřít jde i klávesnicí; každý se otevírá a zavírá zvlášť. *}
{* Řada údajů jako samostatné dlaždice (FiguresWidget::setCards) nemá společnou kartu ani nadpis *}
{var $_figureCards = $widget instanceof ADT\FancyAdmin\UI\Components\Controls\Widgets\FiguresWidget && $widget->isCards() && !$widget->isUnavailable()}
{var $_plain = ($widget instanceof ADT\FancyAdmin\UI\Components\Controls\Widgets\TemplateWidget && $widget->isPlain())
	|| ($widget instanceof ADT\FancyAdmin\UI\Components\Controls\Widgets\AlertsWidget && $widget->isCards() && !$widget->isUnavailable() && $widget->getAlerts())}
{var $_card = ($widget->getType() !== 'tiles' || $widget->isUnavailable()) && $widget->getType() !== 'section' && !$_figureCards && !$_plain}
{var $_accent = $widget instanceof ADT\FancyAdmin\UI\Components\Controls\Widgets\KpiWidget && $widget->isAccent() ? 'fa-widgets-accent fa-widgets-tone-' . $widget->getTone()->value : null}
{var $_callout = $widget instanceof ADT\FancyAdmin\UI\Components\Controls\Widgets\CalloutWidget ? 'fa-widgets-callout fa-widgets-tone-' . $widget->getTone()->value : null}
{var $_link = $widget->getLink() !== null && $widget->getLinkLabel() === null && $widget->getType() !== 'stat' && !$widget->isCollapsible() ? $widget->getLink() : null}
<div n:tag="$widget->isCollapsible() ? details" n:class="$_card ? 'card fa-widgets-card', $_accent, $_callout, $widget->isCollapsible() ? fa-widgets-collapsible, $_link ? fa-widgets-linked, $widget->getPanelGroup() !== null ? fa-widgets-panel, $widget->getToggle() ? fa-widgets-toggler" n:attr="data-widget-toggler: $widget->getToggle() ? $widget->getToggle()['target']">
	{if $widget->isCollapsible()}
		<summary class="fa-widget-header fa-widgets-collapsible-summary">
			<span class="fa-widget-heading">
				<span class="fa-widget-title">{$widget->getTitle()}</span>
				<span n:ifcontent class="fa-widget-subtitle">{$widget->getSubtitle()}</span>
			</span>
			<i class="fa-solid fa-chevron-down fa-widgets-collapsible-chevron" aria-hidden="true"></i>
		</summary>
	{elseif $widget->getType() !== 'section' && !$_figureCards && !$_plain}
		{include header}
	{/if}
	<div n:class="$_card ? 'card-body fa-widgets-card-body'" n:snippet="body">
		{include content}
	</div>
	{* Odkaz, který otevře / zavře panel jiného widgetu (setToggle) - „Seznam nabídek ▾“ *}
	<div n:if="$widget->getToggle()" class="fa-widgets-toggle-foot">
		<button type="button" class="fa-widgets-toggle" data-widget-toggle="{$widget->getToggle()['target']}" aria-expanded="false" data-open-label="{$widget->getToggle()['open']}" data-close-label="{$widget->getToggle()['close']}">
			<span class="fa-widgets-toggle-label">{$widget->getToggle()['open']}</span> <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
		</button>
	</div>
	<a n:if="$_link" href="{$_link}" class="stretched-link fa-widgets-link" aria-label="{$widget->getTitle() ?? $widget->getName()}"></a>
</div>

{define content}
	{if $widget->isUnavailable()}
		<div class="fa-widgets-unavailable">
			<i class="fa-regular fa-clock" aria-hidden="true"></i>
			<div>
				<div class="fa-widgets-unavailable-text">{_fcadmin.widgets.unavailable}</div>
				<div n:if="$widget->getUnavailableReason() !== ''" class="fa-widgets-unavailable-reason">{$widget->getUnavailableReason()}</div>
			</div>
		</div>
	{else}
		{include block ('widget-' . $widget->getType())}
		<div n:if="$widget->getLinkLabel() !== null && $widget->getLink() !== null && $widget->getType() !== 'section'" class="fa-widgets-footer">
			<a href="{$widget->getLink()}" class="fa-widgets-footer-link">{$widget->getLinkLabel()} <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
		</div>
	{/if}
{/define}

{define badges, array $badges}
	<span n:foreach="$badges as $_badge" class="fa-widgets-badge fa-widgets-tone-{$_badge->tone->value}" n:attr="title: $_badge->title">{$_badge->text}</span>
{/define}

{define header}
	{* Stat má nadpis v těle; KPI má štítky pod hodnotou, ne v hlavičce *}
	{var $_title = $widget->getType() !== 'stat' || $widget->isUnavailable() ? $widget->getTitle() : null}
	{var $_badges = $widget->isUnavailable() || $widget->getType() === 'kpi' ? [] : $widget->getBadges()}
	{var $_hintOnTitle = $_title !== null && $widget->getDescription() && in_array($widget->getType(), ['kpi', 'figures', 'alerts', 'funnel', 'callout'], true)}
	{var $_aside = $widget->isUnavailable() ? null : $widget->getAside()}
	<div n:if="$_title !== null || $widget->hasPeriods() || $_badges || $widget->getSwitches() || $_aside !== null" class="fa-widget-header">
		<div n:if="$_title !== null || $_badges" class="fa-widget-heading">
			{* Popis je nápověda k widgetu, ne obsah - tooltip ho na dotyku neukáže, nesmí v něm být nic nepostradatelného.
			   Karty kpi, figures a alerts ho mají na nadpisu (bez ikony, z klávesnice přes tabindex), ostatní na otazníku. *}
			<h2 n:if="$_title !== null" n:class="fa-widget-title, $widget->getTitleStyle() === 'section' ? fa-widget-title-section"{if $_hintOnTitle} tabindex="0" data-bs-toggle="tooltip" data-bs-title="{=htmlspecialchars($widget->getDescription())}"{/if}>{$_title}</h2>
			<span n:ifcontent class="fa-widget-subtitle">{$widget->getSubtitle()}</span>
			{include badges, badges: $_badges}
		</div>
		<span n:if="$_aside !== null" class="fa-widget-aside">{$_aside}</span>
		<button n:if="$widget->getDescription() && !$_hintOnTitle" type="button" class="btn btn-icon btn-sm fa-widget-hint"
			data-bs-toggle="tooltip" data-bs-title="{=htmlspecialchars($widget->getDescription())}" aria-label="{$widget->getDescription()}">
			<i class="fa-regular fa-circle-question" aria-hidden="true"></i>
		</button>
		<i n:if="$_link" class="fa-solid fa-chevron-right fa-widgets-link-arrow" aria-hidden="true"></i>
		<button n:if="$widget->getPanelGroup() !== null" type="button" class="fa-widgets-panel-close" data-widget-toggle="{$widget->getName()}">{_fcadmin.widgets.panel.close}</button>
		{* Přepínače (addSwitch): odkazy fungují i bez JS, s JS překreslí jen widget (widgets.js) *}
		<div n:if="$widget->getSwitches()" class="fa-widgets-switches">
			<div n:foreach="$widget->getSwitches() as $_switchName => $_switch" class="btn-group btn-group-sm fa-widgets-switch" role="group">
				{foreach $_switch['options'] as $_value => $_label}
					{var $_active = $widget->getSwitch($_switchName) === (string) $_value}
					<a href="{$control->getSwitchLink($_switchName, (string) $_value)}" n:class="btn, noajax, $_active ? btn-primary : btn-outline-primary" n:attr="aria-current: $_active ? 'true'"
						data-widget-switch="{$control->getSwitchParameterName($_switchName)}" data-widget-value="{$_value}" data-widget-default="{$_switch['default']}"
						data-widget-redraw="{$control->getRedrawParameterName()}">{$_label}</a>
				{/foreach}
			</div>
		</div>
		<form n:if="$widget->hasPeriods()" class="fa-widgets-period" method="get" action="{$control->getPeriodFormAction()}">
			<input n:foreach="$control->getPeriodFormFields() as $_name => $_value" type="hidden" name="{$_name}" value="{$_value}">
			<select name="{$control->getPeriodParameterName()}" class="form-select form-select-sm" aria-label="{_fcadmin.widgets.period.label}"
				data-widget-period data-widget-redraw="{$control->getRedrawParameterName()}">
				<option n:foreach="$widget->getPeriodOptions() as $_period" value="{$_period->value}" n:attr="selected: $_period === $widget->getPeriod()">{_$_period->getTranslationKey()}</option>
			</select>
			<noscript><button type="submit" class="btn btn-sm btn-outline-secondary">{_fcadmin.widgets.period.submit}</button></noscript>
		</form>
	</div>
{/define}

{define widget-stat}
	<div class="fa-widgets-stat fa-widgets-tone-{$widget->getTone()->value}">
		<div class="fa-widgets-stat-head">
			<span n:if="$widget->getIcon()" class="fa-widgets-icon"><i class="{$format::icon($widget->getIcon())}" aria-hidden="true"></i></span>
			<span class="fa-widgets-stat-label">{$widget->getTitle()}</span>
		</div>
		<div class="fa-widgets-stat-value">{$format::value($widget->getValue())}</div>
		<div n:ifcontent class="fa-widgets-stat-note">{$widget->getNote()}</div>
		<a n:if="$widget->getLink() && $widget->getLinkLabel() === null" href="{$widget->getLink()}" class="stretched-link" aria-label="{$widget->getTitle()}"></a>
	</div>
{/define}

{define widget-section}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\SectionWidget $widget}
	<div n:class="fa-widgets-section, $widget->isMajor() ? fa-widgets-section-major">
		<div class="fa-widgets-section-heading">
			<h2 class="fa-widgets-section-title">{$widget->getTitle()}{if $widget->getSuffix() !== null} · {$widget->getSuffix()}{/if}</h2>
			<span n:ifcontent class="fa-widgets-section-subtitle">{$widget->getSubtitle()}</span>
			{include badges, badges: $widget->getBadges()}
			<a n:if="$widget->getLink() !== null" href="{$widget->getLink()}" class="fa-widgets-section-link">{$widget->getLinkLabel() ?? $widget->getTitle()} <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
		</div>
		{var $_text = $widget->getText()}
		<p n:if="$_text !== null" class="fa-widgets-section-text">{if $_text instanceof Nette\HtmlStringable}{$_text}{else}{$_text}{/if}</p>
	</div>
{/define}

{define widget-split}
	{var $_split = $widget->getSplit()}
	<div n:if="$_split" class="fa-widgets-split">
		<div class="fa-widgets-split-bar" role="presentation">
			<span n:foreach="$_split as $_i => $_part" class="fa-widgets-split-segment fa-widgets-tone-{$_part['split']->tone->value}{if $_i > 0} fa-widgets-split-segment-light{/if}" style="flex-grow: {round($_part['share'] * 1000)}"></span>
		</div>
		{var $_rows = (bool) array_filter($_split, fn($part) => $part['split']->note !== null || $part['split']->extra !== null)}
		<div n:class="fa-widgets-split-legend, $_rows ? fa-widgets-split-rows">
			<div n:foreach="$_split as $_i => $_part" class="fa-widgets-split-item fa-widgets-tone-{$_part['split']->tone->value}">
				<span class="fa-widgets-split-label"><span n:class="fa-widgets-split-dot, $_i > 0 ? fa-widgets-split-segment-light" aria-hidden="true"></span>{$_part['split']->label} <strong>{$_part['split']->display ?? $format::value($_part['split']->value)}</strong>{if !$_rows} · {round($_part['share'] * 100)}&nbsp;%{/if}</span>
				<span n:if="$_rows" class="fa-widgets-split-note">{$_part['split']->note}</span>
				<span n:if="$_rows" class="fa-widgets-split-extra">{if $_part['split']->extraTone}<span class="fa-widgets-value-tone-{$_part['split']->extraTone->value}">{$_part['split']->extra}</span>{else}{$_part['split']->extra}{/if}</span>
			</div>
		</div>
	</div>
{/define}

{define widget-kpi}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\KpiWidget $widget}
	{if $widget->hasParts()}
		<div class="fa-widgets-kpi-parts">
			<div n:foreach="$widget->getParts() as $_part" class="fa-widgets-kpi-part">
				<div class="fa-widgets-kpi-part-label" n:attr="title: $_part->title">{$_part->label}</div>
				<div class="fa-widgets-kpi-value fa-widgets-value-tone-{$_part->tone->value}">
					{$format::value($_part->value ?? '–')}<span n:if="$_part->unit !== null" class="fa-widgets-unit">{$_part->unit}</span>
				</div>
				<div n:if="$_part->badges || $_part->note !== null" class="fa-widgets-kpi-foot">
					{include badges, badges: $_part->badges}
					<span n:if="$_part->note !== null" class="fa-widgets-kpi-note">{$_part->note}</span>
				</div>
			</div>
		</div>
	{else}
		{var $_sparkline = $widget->getSparkline()}
		<div n:class="fa-widgets-kpi, $widget->isDetail() ? fa-widgets-kpi-detail">
			<div class="fa-widgets-kpi-main">
				<div class="fa-widgets-kpi-value fa-widgets-value-tone-{$widget->getTone()->value}">
					{$format::value($widget->getValue() ?? '–')}<span n:if="$widget->getUnit() !== null" class="fa-widgets-unit">{$widget->getUnit()}</span>
				</div>
				<svg n:if="$_sparkline" class="fa-widgets-sparkline fa-widgets-tone-{$widget->getTone()->value}" viewBox="0 0 72 28" width="72" height="28" aria-hidden="true">
					<polyline points="{$_sparkline['points']}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
					<circle cx="{$_sparkline['x']}" cy="{$_sparkline['y']}" r="2.6" fill="currentColor"/>
				</svg>
			</div>
			<div n:if="$widget->getBadges() || $widget->getNote() !== null" class="fa-widgets-kpi-foot">
				{include badges, badges: $widget->getBadges()}
				<span n:if="$widget->getNote() !== null" class="fa-widgets-kpi-note">{$widget->getNote()}</span>
			</div>
			{include widget-split}
		</div>
	{/if}
{/define}

{define widget-figures}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\FiguresWidget $widget}
	{if $widget->getFigures()}
		<div n:class="fa-widgets-figures, $widget->isCards() ? fa-widgets-figures-cards">
			<div n:foreach="$widget->getFigures() as $_figure" n:class="fa-widgets-figure, $widget->isCards() ? 'card fa-widgets-card', $_figure->link !== null ? fa-widgets-figure-linked">
				<div class="fa-widgets-figure-label" n:attr="title: $_figure->title">{$_figure->label}<i n:if="$_figure->link !== null" class="fa-solid fa-chevron-right fa-widgets-link-arrow" aria-hidden="true"></i></div>
				<div class="fa-widgets-figure-value fa-widgets-value-tone-{$_figure->tone->value}">
					{$format::value($_figure->value ?? '–')}<span n:if="$_figure->unit !== null" class="fa-widgets-unit">{$_figure->unit}</span>
					<span n:if="$_figure->note !== null" class="fa-widgets-figure-note">{$_figure->note}</span>
				</div>
				<div n:if="$_figure->badges" class="fa-widgets-kpi-foot">{include badges, badges: $_figure->badges}</div>
				<a n:if="$_figure->link !== null" href="{$_figure->link}" class="stretched-link" aria-label="{$_figure->label}"></a>
			</div>
		</div>
	{else}
		<p class="fa-widgets-empty">{_fcadmin.widgets.empty}</p>
	{/if}
{/define}

{define widget-alerts}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\AlertsWidget $widget}
	{if $widget->getAlerts()}
		{* Kompaktní seznam (setCompact): tečka místo ikony, odkazem je celý řádek; nad limitem (setLimit) skryté
		   položky ukáže tlačítko „Zobrazit všech N“ *}
		{if $widget->isCards()}
			{include alert-cards}
		{else}
		{var $_compact = $widget->isCompact()}
		{var $_limit = $widget->getLimit()}
		{var $_more = $_limit !== null && count($widget->getAlerts()) > $_limit}
		<ul n:class="fa-widgets-alerts, $_compact ? fa-widgets-alerts-compact">
			<li n:foreach="$widget->getAlerts() as $_i => $_alert" n:class="fa-widgets-alert, 'fa-widgets-tone-' . $_alert->tone->value, $_more && $_i >= $_limit ? fa-widgets-alert-extra, $_compact && $_alert->link !== null ? fa-widgets-alert-linked" n:attr="hidden: $_more && $_i >= $_limit">
				{if $_compact}
					<span n:if="$widget->hasDots()" class="fa-widgets-alert-dot" aria-hidden="true"></span>
				{else}
					<i n:class="'fa-solid', $_alert->tone->value === 'danger' ? 'fa-triangle-exclamation' : 'fa-circle-exclamation', fa-widgets-alert-icon" aria-hidden="true"></i>
				{/if}
				<div class="fa-widgets-alert-body">
					{if $_compact && $_alert->link !== null}
						<a href="{$_alert->link}" class="fa-widgets-alert-text stretched-link" n:attr="title: $_alert->linkLabel">{$_alert->text}</a>
					{else}
						<div class="fa-widgets-alert-text">{$_alert->text}</div>
					{/if}
					<div n:if="$_alert->note !== null" class="fa-widgets-alert-note">{$_alert->note}</div>
				</div>
				<span n:if="$_alert->badges" class="fa-widgets-alert-badges">{include badges, badges: $_alert->badges}</span>
				<span n:if="$_alert->value !== null" class="fa-widgets-alert-value">{$format::value($_alert->value)}</span>
				<i n:if="$_compact && $_alert->link !== null" class="fa-solid fa-chevron-right fa-widgets-alert-arrow" aria-hidden="true"></i>
				<a n:if="$_alert->link !== null && !$_compact" href="{$_alert->link}" class="fa-widgets-alert-link">{if $_alert->linkLabel !== null}{$_alert->linkLabel}{else}{_fcadmin.widgets.detail}{/if} <i class="fa-solid fa-chevron-right" aria-hidden="true"></i></a>
			</li>
		</ul>
		<button n:if="$_more" type="button" class="fa-widgets-more" data-widget-more aria-expanded="false" data-open-label="{_fcadmin.widgets.alerts.more, ['count' => count($widget->getAlerts())]}" data-close-label="{_fcadmin.widgets.alerts.less}">{_fcadmin.widgets.alerts.more, ['count' => count($widget->getAlerts())]}</button>
		{/if}
	{else}
		<p class="fa-widgets-empty">{_fcadmin.widgets.alerts.empty}</p>
	{/if}
{/define}

{define widget-funnel}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\FunnelWidget $widget}
	{if $widget->getSteps()}
		{* Krok s přechodem z předchozího: šipka s procentem a poznámkou, pak rámeček kroku *}
		<ol class="fa-widgets-funnel">
			<li n:foreach="$widget->getSteps() as $_i => $_step" class="fa-widgets-funnel-item">
				<span n:if="$_i > 0" class="fa-widgets-funnel-arrow fa-widgets-tone-{$_step->tone->value}">
					<span class="fa-widgets-funnel-conversion">{$_step->conversion ?? '–'}</span>
					<svg viewBox="0 0 40 8" width="40" height="8" aria-hidden="true"><path d="M0 4h37M33 1l4 3-4 3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
					<span n:if="$_step->note !== null" class="fa-widgets-funnel-note">{$_step->note}</span>
				</span>
				<span class="fa-widgets-funnel-step">
					<span class="fa-widgets-funnel-label">{$_step->label}</span>
					<span class="fa-widgets-funnel-value">{$format::value($_step->value ?? '–')}</span>
				</span>
			</li>
		</ol>
	{else}
		<p class="fa-widgets-empty">{_fcadmin.widgets.empty}</p>
	{/if}
{/define}

{define widget-callout}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\CalloutWidget $widget}
	{var $_content = $widget->getCallout()}
	{if $_content}
		<div class="fa-widgets-callout-headline">{$_content->headline}</div>
		<p n:if="$_content->text !== null" class="fa-widgets-callout-text">{$_content->text}</p>
		<div n:if="$_content->items && $_content->itemsTitle !== null" class="fa-widgets-callout-items-title">{$_content->itemsTitle}</div>
		<ul n:if="$_content->items" class="fa-widgets-callout-items">
			<li n:foreach="$_content->items as $_item" n:class="fa-widgets-callout-item, 'fa-widgets-tone-' . $_item->tone->value, $_item->link !== null ? fa-widgets-callout-item-linked">
				{if $_item->link !== null}<a href="{$_item->link}" class="fa-widgets-callout-item-text stretched-link" n:attr="title: $_item->linkLabel">{$_item->text}</a>{else}<span class="fa-widgets-callout-item-text">{$_item->text}</span>{/if}
				<span n:if="$_item->value !== null" class="fa-widgets-callout-item-value">{$format::value($_item->value)}</span>
				<i n:if="$_item->link !== null" class="fa-solid fa-chevron-right fa-widgets-alert-arrow" aria-hidden="true"></i>
			</li>
		</ul>
	{else}
		<p class="fa-widgets-empty">{_fcadmin.widgets.empty}</p>
	{/if}
{/define}

{* Upozornění jako samostatné podbarvené karty (AlertsWidget::setCards): ikona, text se štítky, poznámka,
   proklik jako tlačítko a šedý doplněk vpravo *}
{define alert-cards}
	<ul class="fa-widgets-alert-cards">
		<li n:foreach="$widget->getAlerts() as $_alert" class="fa-widgets-alert-card fa-widgets-tone-{$_alert->tone->value}">
			<span class="fa-widgets-alert-card-icon"><i n:class="'fa-solid', $_alert->tone->value === 'danger' ? 'fa-triangle-exclamation' : 'fa-circle-exclamation'" aria-hidden="true"></i></span>
			<div class="fa-widgets-alert-card-body">
				<div class="fa-widgets-alert-card-head">
					<span class="fa-widgets-alert-text">{$_alert->text}</span>
					{include badges, badges: $_alert->badges}
					<span n:if="$_alert->value !== null" class="fa-widgets-alert-value">{$format::value($_alert->value)}</span>
				</div>
				<div n:if="$_alert->note !== null" class="fa-widgets-alert-note">{$_alert->note}</div>
				<div n:if="$_alert->link !== null || $_alert->aside !== null || $_alert->actions" class="fa-widgets-alert-card-foot">
					<a n:if="$_alert->link !== null" href="{$_alert->link}" class="btn btn-primary btn-sm">{if $_alert->linkLabel !== null}{$_alert->linkLabel}{else}{_fcadmin.widgets.detail}{/if}</a>
					<a n:foreach="$_alert->actions as $_actionLabel => $_actionLink" href="{$_actionLink}" class="btn btn-sm fa-widgets-alert-action">{$_actionLabel}</a>
					<span n:if="$_alert->aside !== null" class="fa-widgets-alert-aside">{$_alert->aside}</span>
				</div>
			</div>
		</li>
	</ul>
{/define}

{define widget-tiles}
	<div class="fa-widgets-tiles">
		<div n:foreach="$widget->getTiles() as $tile" class="card fa-widgets-tile fa-widgets-tone-{$tile->tone->value}">
			<div class="fa-widgets-stat-head">
				<span n:if="$tile->icon" class="fa-widgets-icon"><i class="{$format::icon($tile->icon)}" aria-hidden="true"></i></span>
				<span class="fa-widgets-stat-label">{$tile->label}</span>
			</div>
			<div class="fa-widgets-tile-value">{$format::value($tile->value)}</div>
			<div n:if="$tile->note !== null" class="fa-widgets-stat-note">{$tile->note}</div>
			<a n:if="$tile->link" href="{$tile->link}" class="stretched-link" aria-label="{$tile->label}"></a>
		</div>
	</div>
{/define}

{define widget-table}
	{varType ADT\FancyAdmin\UI\Components\Controls\Widgets\TableWidget $widget}
	{if $widget->getRows()}
		{var $_groups = $widget->getColumnGroups()}
		{var $_total = $widget->getTotal()}
		{var $_linked = (bool) array_filter($widget->getRows(), fn($row) => $widget->getRowLink($row) !== null)}
		<div class="table-responsive">
			<table n:class="table, fa-widgets-table, mb-0, $_groups ? fa-widgets-table-grouped, $widget->isCompact() ? fa-widgets-table-compact">
				<thead>
					{* Pás skupin sloupců nad záhlavím v barvě skupiny: sloupce před první skupinou do ní přecházejí, poslední
					   skupina sahá až k okraji tabulky (i přes sloupec šipky) a ke konci se rozplývá *}
					<tr n:if="$_groups" class="fa-widgets-table-groups">
						{var $_named = array_values(array_filter($_groups, fn($group) => $group['label'] !== null))}
						{var $_cells = array_values($_groups)}
						{var $_lastNamed = max(array_keys(array_filter($_cells, fn($group) => $group['label'] !== null)))}
						{php $_cells[$_lastNamed]['span'] += array_sum(array_column(array_slice($_cells, $_lastNamed + 1), 'span')) + ($_linked ? 1 : 0)}
						{php $_cells = array_slice($_cells, 0, $_lastNamed + 1)}
						{var $_seen = 0}
						{foreach $_cells as $_group}
							{if $_group['label'] === null}
								{var $_edge = $_seen === 0 ? 'lead' : 'gap'}
								{var $_tone = $_seen === 0 ? $_named[0]['tone'] : $_named[$_seen - 1]['tone']}
								<th colspan="{$_group['span']}" class="fa-widgets-table-band fa-widgets-table-band-{$_edge} fa-widgets-tone-{$_tone}" aria-hidden="true"></th>
							{else}
								{php $_seen++}
								<th colspan="{$_group['span']}" n:class="fa-widgets-table-group, $iterator->last ? fa-widgets-table-group-last, 'fa-widgets-tone-' . $_group['tone']" scope="colgroup">{$_group['label']}</th>
							{/if}
						{/foreach}
					</tr>
					<tr>
						<th n:foreach="$widget->getColumns() as $column" n:class="$column->numeric ? 'text-end'" scope="col">{$column->label}</th>
						<th n:if="$_linked" class="fa-widgets-table-arrow" aria-hidden="true"></th>
					</tr>
				</thead>
				<tbody>
					{foreach $widget->getRows() as $_rowIndex => $row}
						{var $_rowLink = $widget->getRowLink($row)}
						{var $_children = $widget->getRowChildren($row)}
						<tr n:class="$_rowLink !== null ? fa-widgets-row-linked, $_children ? fa-widgets-row-parent" n:attr="data-widget-row: $_children ? $_rowIndex">
							{foreach $widget->getColumns() as $key => $column}
								{var $_value = $row[$key] ?? null}
								<td n:class="$column->numeric ? 'text-end text-nowrap', $column->wrap ? fa-widgets-wrap">{if $iterator->isFirst() && $_children}<button type="button" class="fa-widgets-row-toggle" aria-expanded="false" data-widget-row-toggle="{$_rowIndex}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>{/if}<a n:tag-if="$iterator->isFirst() && $_rowLink !== null" href="{$_rowLink}" class="stretched-link">{if $_value instanceof Nette\HtmlStringable}{$_value}{else}{$format::value($_value)}{/if}</a></td>
							{/foreach}
							<td n:if="$_linked" class="fa-widgets-table-arrow">{if $_rowLink !== null}<i class="fa-solid fa-chevron-right" aria-hidden="true"></i>{/if}</td>
						</tr>
						<tr n:foreach="$_children as $_child" class="fa-widgets-row-child" data-widget-row-child="{$_rowIndex}" hidden>
							{var $_childLink = $widget->getRowLink($_child)}
							{foreach $widget->getColumns() as $key => $column}
								{var $_value = $_child[$key] ?? null}
								<td n:class="$column->numeric ? 'text-end text-nowrap', $column->wrap ? fa-widgets-wrap">{if $iterator->isFirst()}<span class="fa-widgets-row-dot" aria-hidden="true"></span>{/if}<a n:tag-if="$iterator->isFirst() && $_childLink !== null" href="{$_childLink}">{if $_value instanceof Nette\HtmlStringable}{$_value}{else}{$format::value($_value)}{/if}</a></td>
							{/foreach}
							<td n:if="$_linked" class="fa-widgets-table-arrow"></td>
						</tr>
					{/foreach}
				</tbody>
				<tfoot n:if="$_total !== null">
					<tr class="fa-widgets-table-total">
						{foreach $widget->getColumns() as $key => $column}
							{var $_value = $_total[$key] ?? null}
							<td n:class="$column->numeric ? 'text-end text-nowrap'">{if $_value instanceof Nette\HtmlStringable}{$_value}{else}{$format::value($_value)}{/if}</td>
						{/foreach}
						<td n:if="$_linked"></td>
					</tr>
				</tfoot>
			</table>
		</div>
	{else}
		<p class="fa-widgets-empty">{_fcadmin.widgets.empty}</p>
	{/if}
{/define}

{define widget-chart}
	{var $_chart = $widget->getChart()}
	{if $_chart->isEmpty()}
		<p class="fa-widgets-empty">{_fcadmin.widgets.empty}</p>
	{else}
		<div n:class="'fa-widgets-chart', $_chart->indexAxis === 'y' ? 'fa-widgets-chart-tall'">
			{* JSON explicitně: pole v atributu převádí na JSON až Latte 3.1, starší vypíše „Array“ *}
			<canvas data-adt-chart='{json_encode($_chart->toConfig(), \JSON_UNESCAPED_UNICODE | \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR)}' role="img" aria-label="{$widget->getTitle()}"></canvas>
		</div>
	{/if}
{/define}

{define widget-template}
	{include $widget->getFile(), ...array_merge(['presenter' => $presenter, 'widgetGrid' => $widgetGrid, 'widget' => $widget, 'period' => $widget->getPeriod()], $widget->getParameters())}
{/define}
